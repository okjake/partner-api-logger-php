{
  "name": "partner-api/logger",
  "description": "Partner API Logger SDK for PHP — send structured logs and metrics to the Partner API ingest service",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "logging",
    "metrics",
    "partner-api",
    "laravel",
    "sdk"
  ],
  "require": {
    "php": "^8.1",
    "guzzlehttp/guzzle": "^7.0",
    "ramsey/uuid": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "orchestra/testbench": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "PartnerApi\\Logger\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "PartnerApi\\Logger\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "PartnerApi\\Logger\\Laravel\\LoggerServiceProvider"
      ],
      "aliases": {
        "PartnerLogger": "PartnerApi\\Logger\\Laravel\\Facades\\PartnerLogger"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable"
}
